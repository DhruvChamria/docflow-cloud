# Copy to .env for Docker Compose. Use local-only passwords; never commit .env.
APP_ENV=local
POSTGRES_DB=docflow
POSTGRES_USER=docflow_dev
POSTGRES_PASSWORD=replace-with-local-only-password
GRAFANA_PASSWORD=replace-with-another-local-only-password
DEMO_FAIL_FIRST_ATTEMPT=false
APP_ALLOWED_ORIGIN=http://localhost:5173
# Document-encryption keys are generated into a private Docker volume by secret-init.
APP_SESSION_SECRET=
